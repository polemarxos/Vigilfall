{
  "schema": 1,
  "game": "vigilfall",
  "name": "Vigilfall",
  "adapter": "realm",
  "updated": "2026-11-23",
  "servers": {
    "realm": "https://vigilfall.duckdns.org",
    "adminPage": "https://vigilfall.duckdns.org/admin",
    "ssh": "ubuntu@wsgame.duckdns.org",
    "service": "vigilfall-realm"
  },
  "control": {
    "repo": "polemarxos/Vigilfall",
    "backupsRepo": "polemarxos/Vigilfall-backups"
  },
  "versions": {
    "game": "1.29.0",
    "server": "1.14.0",
    "admin": "Vigilfall Admin 1.10",
    "androidApp": "Vigilfall.json"
  },
  "api": {
    "auth": "Bearer <admin password>",
    "paths": [
      "status",
      "players",
      "players/<pid>",
      "players/<pid>/kick|ban|unban|password|gm|backups|restore",
      "live",
      "dm",
      "mute",
      "announce",
      "events",
      "config",
      "fullbackups",
      "restart",
      "update",
      "server/update",
      "versions",
      "log"
    ]
  },
  "modules": [
    "health",
    "ssh",
    "backups",
    "announcements",
    "events",
    "players",
    "saveEdit",
    "maintenance",
    "alerts",
    "updates"
  ],
  "secretsIn": "Games Admin vault: realm_pass, ssh_key, github (never in this file)"
}
